rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios con sesión (anónima) de la app pueden leer y escribir
    match /encargos/{id} {
      allow read, write: if request.auth != null;
    }
    // Fotos de evidencia (una por documento, comprimidas por la app)
    match /fotos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
